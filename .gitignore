# Python caches and local virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
*.raw.txt

# Local database-volume backups and review-only artifacts
lab/**/backups/
lab/**/backup/
/.amp/in/

# Local environment secrets; keep safe example templates trackable
.env
.env.*
!.env.example
!.env.*.example

# Private key directories and key material across labs
**/keys/
*.key
*.pem
**/secrets/*
!**/secrets/*.example

# Local page renders generated by verify_report.py
/renders/

# Publish per-chapter PDFs only; keep the optional combined PDF local
/output/3123640021_Andi.pdf

# OS metadata
.DS_Store
Thumbs.db

# Intentionally trackable: chapters/, lab/, evidence/, assets/, and output/babN/*.pdf
# Public certificates using .crt/.cer remain trackable; never store private keys with those extensions.
